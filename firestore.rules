rules_version = '2';

// Regras do Firestore — Casa da Criança
//
// Como publicar: Console do Firebase → Firestore Database → Regras →
// colar este conteúdo → Publicar.
//
// ATENÇÃO — ordem para não ficar sem acesso:
//   1. Abra o app já atualizado e confirme o e-mail da sua conta (a tela
//      "Confirme seu e-mail" aparece sozinha).
//   2. Só depois publique estas regras. Elas exigem e-mail confirmado.
//
// Quem é quem:
//   • Equipe da ONG = conta com e-mail confirmado e listado em ehEquipe().
//   • Doador        = qualquer outra conta com e-mail confirmado.
//   • Visitante     = sem conta: só lê a lista pública de necessidades.
//
// O que cada um pode fazer:
//   • Visitante → LER `necessidades`.
//   • Doador    → LER `necessidades`, CRIAR sugestão em `doacoes` (sempre
//                 'pendente', no máximo 3 por dia) e LER só as próprias.
//   • Equipe    → ler e escrever tudo.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function verificado() {
      return logado() && request.auth.token.email_verified == true;
    }

    // ► Esta lista precisa ser IGUAL à EMAILS_EQUIPE de services/papeis.ts.
    function ehEquipe() {
      return verificado()
        && request.auth.token.email in [
          'souza.joaojjg@gmail.com'
        ];
    }

    // Data de hoje (UTC) como AAAAMMDD — igual ao cálculo do app.
    function hoje() {
      return string(request.time.year() * 10000
                  + request.time.month() * 100
                  + request.time.day());
    }

    // Lista pública de necessidades: todos leem, só a equipe publica.
    match /necessidades/{id} {
      allow read: if true;
      allow write: if ehEquipe();
    }

    // Sugestões de doação.
    //   Teto diário: o ID precisa ser uid_AAAAMMDD_n com n de 1 a 3. Como o
    //   doador não pode alterar documentos, após usar os 3 IDs do dia não
    //   existe mais ID livre.
    match /doacoes/{id} {
      allow create: if verificado()
        && id in [
          request.auth.uid + '_' + hoje() + '_1',
          request.auth.uid + '_' + hoje() + '_2',
          request.auth.uid + '_' + hoje() + '_3'
        ]
        && request.resource.data.keys().hasOnly([
          'doadorUid', 'produtoId', 'nomeItem', 'emoji', 'quantidade',
          'doadorNome', 'doadorContato', 'observacao', 'status', 'criadoEm'
        ])
        && request.resource.data.keys().hasAll([
          'doadorUid', 'nomeItem', 'emoji', 'quantidade',
          'doadorNome', 'doadorContato', 'status', 'criadoEm'
        ])
        && request.resource.data.doadorUid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm == request.time
        && request.resource.data.nomeItem is string
        && request.resource.data.nomeItem.size() >= 2
        && request.resource.data.nomeItem.size() <= 80
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 16
        && request.resource.data.quantidade is int
        && request.resource.data.quantidade >= 1
        && request.resource.data.quantidade <= 9999
        && request.resource.data.doadorNome is string
        && request.resource.data.doadorNome.size() >= 2
        && request.resource.data.doadorNome.size() <= 80
        && request.resource.data.doadorContato is string
        && request.resource.data.doadorContato.size() >= 5
        && request.resource.data.doadorContato.size() <= 80
        && (request.resource.data.get('produtoId', null) == null
            || request.resource.data.produtoId is string)
        && (request.resource.data.get('observacao', null) == null
            || (request.resource.data.observacao is string
                && request.resource.data.observacao.size() <= 300));

      // A equipe lê tudo; o doador lê só as próprias (para o histórico).
      // 'get' também vale para um ID que ainda não existe (resource == null):
      // é como o app descobre qual dos 3 IDs do dia está livre.
      allow get: if ehEquipe()
        || (verificado()
            && (resource == null || resource.data.doadorUid == request.auth.uid));
      allow list: if ehEquipe()
        || (verificado() && resource.data.doadorUid == request.auth.uid);

      allow update, delete: if ehEquipe();
    }

    // Todo o resto (produtos, lotes, movimentações, categorias): só a equipe.
    match /{document=**} {
      allow read, write: if ehEquipe();
    }
  }
}
